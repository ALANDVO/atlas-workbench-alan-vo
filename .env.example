# Atlas Workbench environment variables
# Copy to .env and fill in real values. Never commit .env.

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-32-char-min-secret-key

# Database (SQLite by default; override with PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./atlas.db

# Redis (for sessions, rate limiting)
REDIS_URL=redis://localhost:6379/0

# OIDC / Keycloak
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8080/realms/atlas
OIDC_CLIENT_ID=atlas-workbench
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_LOGOUT_REDIRECT_URI=http://localhost:5173
OIDC_SCOPES=openid,profile,email,roles

# Demo mode (local-only; binds to 127.0.0.1 only)
DEMO_MODE=false

# LLM Provider (optional)
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Compression Engine
DEFAULT_COMPRESSION_MODE=compress
COMPRESSION_TARGET_RATIO=0.35
MAX_CONTEXT_TOKENS=128000

# MCP
MCP_ENABLED=true